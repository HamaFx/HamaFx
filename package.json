{
  "name": "hamafx-trading-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Hama Fx — AI Trading Intelligence platform for forex and crypto paper trading.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:ui": "playwright test --ui",
    "build": "vite build",
    "build:stats": "node scripts/build-stats.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run build:stats && npm run check:bundle-budget",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.563.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@netlify/mcp": "^1.15.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "^4.0.18"
  }
}
