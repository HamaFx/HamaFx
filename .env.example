# Public runtime variables (safe to expose client-side only if intentionally public).
VITE_APP_NAME=HamaFX
VITE_BACKEND_MODE=off
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# V2 Backend (server-side; set in Vercel project envs)
AUTH_JWT_SECRET=
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
CORS_ALLOWED_ORIGIN=
NEWSDATA_API_KEY=
COINGECKO_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
SCITELY_API_KEY=
SCITELY_MODEL=
AI_PROVIDER=auto
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
PROTECTION_BYPASS_SECRET=

# Sentry sourcemap upload (build-time; optional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional local E2E against deployed URL.
# Example: https://your-project.vercel.app
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_PROTECTION_BYPASS=
